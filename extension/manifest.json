{
  "manifest_version": 3,
  "name": "Perekam Alur Playbook",
  "version": "0.1.0",
  "description": "Rekam alur sebuah web menjadi panduan langkah demi langkah untuk Event Tracker Playbook.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "unlimitedStorage"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Perekam Alur Playbook"
  }
}
